# =============================================
# Auth Server — environment variables
# Copy to .env and fill values.
# DO NOT commit .env to git.
# =============================================

# Database
DATABASE_URL=postgresql://auth:auth@postgres:5432/auth

# Redis (pending approvals, rate limit)
REDIS_URL=redis://redis:6379

# NextAuth
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_URL=https://auth.burakaydogan.tk
AUTH_TRUST_HOST=true

# JWT signing (RS256) — generate with scripts/gen-jwt-keys.sh
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Expo Push Service (optional, raises rate limits)
EXPO_ACCESS_TOKEN=

# Approval mode default: push | numeric | both
APPROVAL_MODE=push
APPROVAL_TTL_SECONDS=300
NUMERIC_CODE_LENGTH=6

# Node
NODE_ENV=development

# Traefik labels için auth-server kendi hostname'i (forwardAuth kendine uygulanmaz)
PUBLIC_HOST=auth.burakaydogan.tk
